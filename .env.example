# --- LLM ---
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
APP_TIMEZONE=Asia/Kolkata

# --- Google Sheets storage ---
# Service-account JSON, stringified. Paste the entire JSON on one line.
# Share the target Sheet with this service account email.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=

# --- Google Calendar OAuth ---
# Create a "Web application" OAuth client in Google Cloud.
# Local redirect URI: http://localhost:3000/api/auth/google/callback
# Vercel redirect URI: https://your-app.vercel.app/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Long random value used to sign login cookies. Example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

# --- Slack ---
# Optional. If empty, briefings show a copyable preview instead of posting.
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=#supply-partnership-product
